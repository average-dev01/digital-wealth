# Copy to .env and fill in real values. Never commit .env.
#
# This root .env is read by `docker compose` (for the Postgres container) and
# documents /backend's variables. /backend is currently dormant (not wired to
# /frontend  see CLAUDE.md); /frontend has its own separate .env with its
# Supabase credentials and doesn't use anything below. backend/.env.example
# has the same subset scoped to just the backend process.

# --- Postgres (Docker, service name "db") ---
POSTGRES_USER=dwp
POSTGRES_PASSWORD=change_me
POSTGRES_DB=digital_wealth

# --- Backend (Express) ---
# Host is "localhost" because the backend runs natively (pnpm), not in Docker,
# and connects to the Postgres container via its published port.
DATABASE_URL=postgresql://dwp:change_me@localhost:55432/digital_wealth?schema=public
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
CSRF_SECRET=
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:8080

# Market data feed. Coinpaprika free tier: 20,000 calls/month, no API key
# required. One batched call per refresh, so cost does not grow with the size
# of the currency catalogue. 300000ms => ~8,640 calls/month.
PRICE_FEED_ENABLED=true
PRICE_PROVIDER=coinpaprika
PRICE_REFRESH_INTERVAL_MS=300000
