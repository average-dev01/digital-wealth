# Copy to backend/.env and fill in real values. Never commit .env.
DATABASE_URL=postgresql://dwp:change_me@localhost:55432/digital_wealth?schema=public
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Read only by `prisma/seed.ts`, not by the running app. Optional  falls
# back to admin@digitalwealth.example / admin1234 (the demo values) when
# unset, which is what local dev and the test DB use. Set both in production
# and re-run `pnpm prisma:seed` any time you want to rotate the password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Market data feed. Coinpaprika free tier: 20,000 calls/month, no API key
# required. One batched call per refresh, so cost does not grow with the size
# of the currency catalogue. 300000ms => ~8,640 calls/month.
PRICE_FEED_ENABLED=true
PRICE_PROVIDER=coinpaprika
PRICE_REFRESH_INTERVAL_MS=300000
# Transactional email (password reset), via Resend's free tier (SMTP relay).
# Requires a verified sending domain in the Resend dashboard for production
# an unverified account can only send to the account owner's own address.
# Falls back to logging the reset link to the console when unset (local dev).
RESEND_API_KEY=
EMAIL_FROM=Digital Wealth Partners <noreply@yourdomain.com>
