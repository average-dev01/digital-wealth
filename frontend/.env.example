# Copy to .env. Never commit .env.
# Frontend-only variables. NEXT_PUBLIC_* are inlined into the client bundle at
# build time, so never put a secret in one.

# Base URL for the backend. lib/api/client.ts reads this.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Used ONLY by `pnpm translate` to regenerate messages/{ar,fr,es}.json.
# Deliberately not NEXT_PUBLIC_  it must never reach the browser, and no
# runtime code reads it. The app serves the generated JSON, so it runs fine
# without this set. Free-tier keys end in ":fx".
DEEPL_API_KEY=
